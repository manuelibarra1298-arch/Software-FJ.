# Excepsiones personalizadas
"""Python cuenta con sus propios errores como "ValueError" o "TypeError", pero son errores generales. para 
que el sistema detecte exctamente que fallo se opta por crear errores personalizados que permitan detectar
donde se genero el error, los cuales heredan de una clase base."""

class softwareFJError(Exception):
    """Es el error base para todos los errres del sistema."""
    def __init__(self, mensaje = "Error en el Sistema", codigo = "Er-000"):
        #se guarda el mensaje y un codigo para identificar el error.
        self.mensaje = mensaje
        self.codigo = codigo
        super().__init__(f"[{codigo}]{mensaje}")
        
class DatoInvalidoError(softwareFJError):
    """Se aplica cuando un dato no es valido."""
    def __init__(self, mensaje = "Dato Invalido"):
        super().__init__(mensaje, "Er-001")

class ParametroFaltanteError(softwareFJError):
    """Se aplica cuando hace falta un dato importante."""
    def __init__(self, mensaje = "Campo Faltante"):
        super().__init__(mensaje, "Er-002")

class ClienteInvalidoError(softwareFJError):
    """Se aplica cuando un cliente no se pudo registrar o no existe."""
    def __init__(self, mensaje = "Cliente Invalido"):
        super().__init__(mensaje, "Er-003")

class servicioNoDisponibleError(softwareFJError):
    """Se aplica cuando un servicio no esta en existencia o no esta disponible."""
    def __init__(self, mensaje = "Servicio Fuera De Existencia"):
        super().__init__(mensaje, "Er-004")
    
class OperacionNoPermitidaError(softwareFJError):
