"""Al careser de bases de datos se hace necesario crear un sistema que permita 
guardar los datos, el cual se opta por crear la clase "logger" el cual nos permite 
rgistrar eventos y errores """

class Logger:
    """Ecribe los events y errores en un archivo de texto."""
    def __init__(self, ruta = os.path.join("logs", "software_FJ.log")):
        # guardamos la ruta del archivo
        self._ruta = ruta
        try:
            # creacion de la carpeta "logs" si no existe.
            os.makedirs(os.path.dirname(self._ruta), exist_ok = True)
        except OSError as e:
            print(f"[ADVERTENCIA] no se pudo crear la carpeta de logs: {e}")
            
    def _escribir(self, nivel, mensaje):
        """metodo interno:escribe una linea con la fecha, el nivel
        y el texto en el archivo"""
        marca = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        try:
            # el modo "a" significa "agregar": asi no se borra lo anterior
            # y el log se va acumulando entre una ejecucion y otra.
            with open(self._ruta, "a", encoding = "utf-8") as archivo:
                archivo.write(f"[{marca}] [{nivel:<6}] {mensaje}\n")
        except OSError as e:
            # si falla la escritura, solo se da un mensaje de advertencia, pero el programa sigue funcionando.
            print(f"[ADVERTENCIA] no se pudo escribir en el archivo de logs: {e}")
    
    def evento(self, mensaje):
        """anota una operacion exitosa"""
        self._escribir("INFO", mensaje)
    
    def error(self, mensaje, excepcion = None):
        """ anota un error. si recibe una exepcion, tambien escribe
        sus causas. esto nos sirve para el encadenamiento de exepciones:
        siendo que un error puede ocurrir por otro error, y asi se podemos 
        ver todo el historial de lo susedido."""
        self._escribir("ERROR", mensaje)
        actual = excepcion
        nivel = 0
        while actual is None:
            # lo primero es el error princpal, lo sigiente son las cuasas.
            etiqueta = "EXCEPCION" if nivel == 0 else "Causado por"
            self._escribir("ERROR", f" -> {etiqueta}: {type(actual).__name__}: {actual}")
            # __cause__ guarda el error original cuando usamos "raise ... from ..."
            actual = actual.__cause__
            nivel += 1
            
# creamos un logger global para que todas las partes del sistema puedan usarlo.
log = Logger()

# creamos una clase llamada validador, en vez de repetir las mismas reviciones en cliente, servicio y reserva, 
# las escrivimos de una sola vez aqui. si una regla cambia, la cambiamos en un solo lugar, 
# cada validacio devuelve un dato limpio si esta correcto, o lanza una excepcion si no lo esta

class Validador:
    """ Reune las validaciones que se usaran en todo el sistema"""
    @staticmethod
    def texto(valor, campo, minimo = 2):
        """valida que sea un texto verdadero y que tenga un minimo de caracteres."""
        if valor is None:
            raise ParametroFaltanteError(f"Falta el campo'{campo}'")   
        if not isinstance(valor, str) or len(valor.strip()) < minimo:
            raise DatoInvalidoError(f"'{campo}' debe ser un texto de al menos {minimo} caracteres")
        # strip() elimina los espacios sobrantes al nico y al final.
        return valor.strip()
    
    @staticmethod
    def email(valor):
        """valida que el correo tenga el formao correcto."""
        valor = Validador.texto(valor, "email", 5)
        # esta expresion regular describe el formato del correo sencillo.
        if not re.fullmatch(r"[\w.+-]+@[\w-]+\.[\w.-]+", valor):
            raise DatoInvalidoError(f"Email con formato incorrecto: '{valor}'")
        return valor.lower()

    @staticmethod 
    def telefono(valor):
        """valida que el telefono solo tenga numeros y que tenga de 7 a 10 digitos"""
        valor = Validador.texto(valor,"telefono", 7)
        if not valor.isdigit() or not 7 <= len(valor) <= 10:
            raise DatoInvalidoError("el telefono tiene que tener entre 7 y 10 digitos")
        return valor

    @staticmethod
    def numero_positivo(valor, campo):
        """valida que el numero sea positivo"""   
        if valor is None:
            raise ParametroFaltanteError(F"falta el campo '{campo}'")
        # en python true t false cuentan como numeros(1 y 0) los excluimos
        # para que alguien no pase por true como si fuera un precio.
        if isinstance(valor, bool) or not isinstance(valor, (int,float)) or valor <= 0:
            raise DatoInvalidoError(f"'{campo}' debe ser un numero positivo")
        return valor
    
    # creamos una clase abstracta llamada "Entidad" 
    # ya que un cliente, un servicio y una reserva son cosas diferentes, pero
    # todas cuentan con un identificador y un nombre.
class Entidad(ABC):
    """base comun para todo lo que se genera en el sistema."""
    # se agrega un contador que pertenece a la clase, compartiendose entre todos y sirve para 
    # dar ids que no se repitan.
    _contador = 0
    
    def __init__(self, nombre):
        # antes de guardar el nombre se valida
        self._nombre = Validador.texto(nombre, "nombre")
        Entidad._contador += 1
        self._id = Entidad._contador
        
    @property
    def id(self):
        """el id solo se puede leer; nadie puede cambiarlo desde afuera."""
        return self._id
    
    @property
    def nombre(self):
        """el nombre tambien se consulta por una propiedad (encapsulacion)."""
        return self._nombre
    
    @abstractmethod
    def describir(self):
        """obliga a que cada clase hija explique como se describe a si misma, siendo
        el polimorfismo: un mismo metodo, comportamientos distintos."""
        
    def __str__(self):
        # cuando hagamos print(objeto), se mostrara su decripcion.
        return self.describir()
    
    # creamos la clase "sistema", ya que no se puede usar bases de datos los clientes,
    # las reservas y lo servicios se guardaran en listas dentro de esta clase.
    class Sistema:
        """Guarda las listas internas y ejecuta operaciones de forma protegida."""
 
    def __init__(self):
        self._clientes = []
        self._servicios = []
        self._reservas = []
        self._ok = 0        # cuantas operaciones salieron bien
        self._fallos = 0    # cuantas operaciones fallaron
 
    def ejecutar_seguro(self, descripcion, funcion, *args, **kwargs):
        """
        Ejecuta una operacion cuidando que nada tumbe el programa.
 
        Usa las tres partes del manejo de excepciones:
          - try/except : intenta la operacion y atrapa los errores.
          - else       : si NO hubo errores, anota el exito.
          - finally    : pase lo que pase, deja constancia de que se intento.
 
        Devuelve el resultado de la operacion, o None si fallo.
        """
        try:
            resultado = funcion(*args, **kwargs)
        except SoftwareFJError as e:
            # Es un error que nosotros previmos: lo anotamos y seguimos.
            self._fallos += 1
            log.error(f"FALLO: {descripcion}", e)
            print(f"  [X] {descripcion} -> {e}")
            return None
        except Exception as e:
            # Es un error que NO habiamos previsto. Lo envolvemos en uno de
            # los nuestros, guardando el original como causa (encadenamiento).
            self._fallos += 1
            try:
                raise SoftwareFJError("Error inesperado", "FJ-999") from e
            except SoftwareFJError as envuelto:
                log.error(f"FALLO INESPERADO: {descripcion}", envuelto)
            print(f"  [X] {descripcion} -> error inesperado: {e}")
            return None
        else:
            # Solo llegamos aqui si el try termino sin ningun error.
            self._ok += 1
            log.evento(f"OK: {descripcion}")
            print(f"  [OK] {descripcion}")
            return resultado
        finally:
            # El finally se ejecuta siempre, haya salido bien o mal.
            log.evento(f"Intento finalizado: {descripcion}")
 
    def _agregar(self, coleccion, objeto):
        """Guarda un objeto en la lista que se le indique y lo devuelve."""
        coleccion.append(objeto)
        return objeto
 
    def _buscar(self, coleccion, id_buscado, error=DatoInvalidoError):
        """Busca un elemento por su id; si no lo encuentra, lanza el error indicado."""
        for item in coleccion:
            if item.id == id_buscado:
                return item
        raise error(f"No existe un elemento con id {id_buscado}")
